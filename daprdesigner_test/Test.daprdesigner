<?xml version="1.0" encoding="UTF-8"?>
<daprdesigner:DaprArchitecture xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:daprdesigner="http://dapr.io/daprtools/daprdesigner">
  <buildingblocks name="development">
    <subblocks name="apps" blockType="MICROSERVICES">
      <nodes xsi:type="daprdesigner:NodeBlocks" name="account"/>
      <nodes xsi:type="daprdesigner:NodeBlocks" name="orders"/>
      <nodes xsi:type="daprdesigner:NodeBlocks" name="cart"/>
    </subblocks>
    <subblocks name="actors" blockType="ACTORS">
      <nodes xsi:type="daprdesigner:NodeBlocks" name="payments" nodeBlockType="ACTOR"/>
      <nodes xsi:type="daprdesigner:NodeBlocks" name="user_events" nodeBlockType="ACTOR"/>
    </subblocks>
    <subblocks name="workflows" blockType="WORKFLOW">
      <nodes xsi:type="daprdesigner:NodeBlocks" name="fulfillment" nodeBlockType="WORKFLOW"/>
      <nodes xsi:type="daprdesigner:NodeBlocks" name="returns" nodeBlockType="WORKFLOW"/>
    </subblocks>
    <subblocks isReady="true" name="secretsstore" blockType="SECRETSTORE">
      <nodes xsi:type="daprdesigner:NodeBlocks" isReady="true" name="aws" nodeBlockType="SECRETSTORE">
        <nodes xsi:type="daprdesigner:SpecMetadata" isReady="true" name="region" value="us-east-1"/>
        <nodes xsi:type="daprdesigner:SpecMetadata" isReady="true" name="accessKey" value="12345"/>
        <nodes xsi:type="daprdesigner:SpecMetadata" isReady="true" name="secretKey" isFetchedFromEnvironment="true" envRef="AWS_SECRETKEY"/>
        <nodes xsi:type="daprdesigner:SecretStore" isReady="true" name="aws_secretstore" providerName="secretstores.aws.secretmanager" providerVersion="v1" metadata_namespace="//@buildingblocks.0/@nodes.0" specMetadata="//@buildingblocks.0/@subblocks.3/@nodes.0/@nodes.0 //@buildingblocks.0/@subblocks.3/@nodes.0/@nodes.1 //@buildingblocks.0/@subblocks.3/@nodes.0/@nodes.2"/>
      </nodes>
    </subblocks>
    <subblocks name="statestore" blockType="STATESTORE">
      <nodes xsi:type="daprdesigner:NodeBlocks" name="redis" nodeBlockType="STATESTORE"/>
    </subblocks>
    <subblocks name="bindings_18" blockType="BINDINGS">
      <nodes xsi:type="daprdesigner:NodeBlocks" name="postgres" nodeBlockType="BINDING"/>
      <nodes xsi:type="daprdesigner:NodeBlocks" name="mail" nodeBlockType="BINDING"/>
    </subblocks>
    <subblocks name="pubsub_22" blockType="PUBSUB">
      <nodes xsi:type="daprdesigner:NodeBlocks" name="redis" nodeBlockType="PUBSUB"/>
    </subblocks>
    <subblocks name="middleware" blockType="MIDDLEWARE"/>
    <subblocks name="service_config" blockType="CONFIGURATIONGROUP">
      <nodes xsi:type="daprdesigner:NodeBlocks" name="subscription" nodeBlockType="SUBSCRIPTION"/>
      <nodes xsi:type="daprdesigner:NodeBlocks" name="resiliency" nodeBlockType="RESILIENCY"/>
    </subblocks>
    <nodes xsi:type="daprdesigner:Namespace" isReady="true" name="dev"/>
    <nodes xsi:type="daprdesigner:Trustdomain" isReady="true" name="public"/>
  </buildingblocks>
</daprdesigner:DaprArchitecture>

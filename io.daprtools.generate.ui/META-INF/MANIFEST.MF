Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: DaprDesigner Generator
Bundle-SymbolicName: io.daprtools.generate.ui;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Activator: io.daprtools.generate.ui.Activator
Bundle-Vendor: io.github.daprdesigner
Require-Bundle: org.eclipse.ui,
 org.eclipse.core.runtime,
 org.eclipse.core.resources,
 io.daprtools.generate,
 org.eclipse.acceleo.engine
Bundle-RequiredExecutionEnvironment: JavaSE-17
Bundle-ActivationPolicy: lazy
Eclipse-LazyStart: true
Automatic-Module-Name: io.daprtools.generate.ui
Export-Package: io.daprtools.generate.ui;uses:="org.osgi.framework,org.eclipse.ui.plugin",
 io.daprtools.generate.ui.common;uses:="org.eclipse.core.runtime,org.eclipse.emf.common.util,org.eclipse.core.resources",
 io.daprtools.generate.ui.popupMenus;
  uses:="org.eclipse.ui,
   org.eclipse.ui.actions,
   org.eclipse.jface.action,
   org.eclipse.jface.viewers"

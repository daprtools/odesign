 daprdesigner.editor;bundle-version="1.0.0",
 io.dapr.daprdesigner.design;bundle-version="1.0.0"
Bundle-RequiredExecutionEnvironment: JavaSE-17
Bundle-ActivationPolicy: lazy
Eclipse-LazyStart: true
Automatic-Module-Name: io.daprtools.generate.ui
Export-Package: io.daprtools.generate.ui,
 io.daprtools.generate.ui.common,
 io.daprtools.generate.ui.popupMenus

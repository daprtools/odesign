[comment encoding = UTF-8 /]
[module generateSubscription('http://dapr.io/daprtools/daprdesigner')]


[template public generateElement(aSubscriptionConfiguration : SubscriptionConfiguration)]
[comment @main/]
[file ('./configuration/'+aSubscriptionConfiguration.name+'.yaml', false, 'UTF-8')]
apiVersion: dapr.io/v2alpha1
kind: Subscription
metadata:
  name: [aSubscriptionConfiguration.name/]
spec:
  topic: [aSubscriptionConfiguration.topicName/]
[if (aSubscriptionConfiguration.routeRules->select(p | p.isDefault)->size() = 1)]
[let r : RouteRules = self.routeRules->select(p | p.isDefault)->at(1)]
  routes:
    default: [r.path/]	
[/let]
[elseif (aSubscriptionConfiguration.routeRules->size()>0)]
  routes:
    rules:
[for (rr:RouteRules | aSubscriptionConfiguration.routeRules)]
      - match: [rr.match/]
        path: [rr.path/]
[/for]
[/if]
  pubsubname: [aSubscriptionConfiguration.pubsubComponent.name/]
  deadLetterTopic: [aSubscriptionConfiguration.deadLetterTopic/]
[if (aSubscriptionConfiguration.bulkSubscribe_enabled)]
  bulkSubscribe: 
    enabled: [aSubscriptionConfiguration.bulkSubscribe_enabled/]
    maxMessagesCount: [aSubscriptionConfiguration.bulkSubscribe_maxMessagesCount/]
    maxAwaitDurationMs: [aSubscriptionConfiguration.bulkSubscribe_maxAwaitDurations/]
[/if]
[if (aSubscriptionConfiguration.scopes->size() >0)]
scopes:
[for (app:App | aSubscriptionConfiguration.scopes)]
  - [app.appId/]
[/for]
[/if]
[/file]
[/template]

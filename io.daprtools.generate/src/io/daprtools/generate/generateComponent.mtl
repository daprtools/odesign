[comment encoding = UTF-8 /]
[module generateComponent('http://dapr.io/daprtools/daprdesigner')]


[template public generateElement(aComponent : Component)]
[comment @main/]
[file ('./component/'+aComponent.name+'.yaml', false, 'UTF-8')]
apiVersion: dapr.io/v1alpha1
kind: Component
[if (not aComponent.auth->isEmpty())]
auth:
	secretstore: [aComponent.auth.name/]
[/if]
metadata:
	name: [aComponent.name/]
	namespace: [aComponent.metadata_namespace.name/]
spec:
	type: [aComponent.providerName/]
	version: [aComponent.providerVersion/]
[if ((aComponent.initTimeout <> null) )]
[if  (not aComponent.initTimeout.trim().equalsIgnoreCase(''))]
	initTimeout: [aComponent.initTimeout/]
[/if]
[/if]
	ignoreErrors: [aComponent.ignoreErrors/]
[if (aComponent.specMetadata->size() > 0)]
	metadata:
[for (sp:SpecMetadata | aComponent.specMetadata)]
[if (sp.isFetchedFromSecret)]
		-  name: [sp.name/]
		   secretKeyRef: 
			name: [sp.secretKeyRefName/] 
			key:  [sp.secretKeyRefKey/]
[elseif (sp.isFetchedFromEnvironment)]
		-  name: [sp.name/]
		   envRef: [sp.envRef/]
[else]
		-  name: [sp.name/]
		   value: [sp.value/]
[/if]
[/for]	
[/if]
[if (aComponent.scopes->size() > 0)]
scopes:
[for (app:App | aComponent.scopes)]
	- [app.appId/]
[/for]
[/if]

[/file]
[/template]

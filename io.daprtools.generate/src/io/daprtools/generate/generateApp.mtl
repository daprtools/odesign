[comment encoding = UTF-8 /]
[module generateApp('http://dapr.io/daprtools/daprdesigner')]


[template public generateElement(anApp : App)]
[comment @main/]
[file (anApp.name +'.yaml', false, 'UTF-8')]
apiVersion: dapr.io/v1alpha1
kind: Configuration
metadata:
	name: [anApp.name/]
	namespace: [anApp.namespace.name/]
[if (anApp.configurations->size() > 0) ]
spec:
[for (  ac:AppConfiguration | anApp.configurations) ]

[if (ac.eClass().name = 'AppAccessControl')]
	accessControl: 
		defaultAction: [ac.eGet('defaultAction').toString().toLowerCase()/]
		trustDomain: [ac.eGet('trustDomain').eGet('name')/]
[if (ac.eGet('policies')->size() >0)]
		policies:
[for (ap:AppPolicy | ac.eGet('policies')) ]
		- appId: [ap.app.name/]
		  defaultAction: [ap.defaultAction.toString().toLowerCase()/]
		  namespace: [ap.namespace.name/]	
[if (ap.operations->size() > 0)]
		  operations: 
[for (o:Operation | ap.operations)]
		  - name: [o.operationName/]
[if (o.protocol = Protocol::HTTP)]
			httpVerb: ['['/][if (o.applyToGet)]'GET',[/if][if (o.applyToPost)] 'POST',[/if][if (o.applyToPut)] 'PUT',[/if][if (o.applyToPatch)] 'PATCH',[/if][if (o.applyToDelete)]'DELETE'[/if][']'/]
[/if]
			action: [o.action.toString().toLowerCase()/]			
[/for]
[/if]
[/for]
[/if]
[elseif (ac.eClass().name = 'DeniedComponentsConfiguration')]
[if (ac.eGet('deniedComponents')->size()>0)]
	components:
		deny: 
[for (c:Component | ac.eGet('deniedComponents') )]
		 - [c.providerName/]
[/for]
[/if]
[elseif (ac.eClass().name = 'LoggingConfiguration')]
	logging:
		apiLogging:
			enabled: [ac.eGet('enabled')/]
			obfuscateURLs: 	[ac.eGet('obfuscateUrls')/]
			omitHealthChecks: [ac.eGet('omitHealthChecks')/]
[elseif (ac.eClass().name = 'NameResolutionConfiguration')]
	nameResolution:
    	component: "[ac.eGet('nameResolutionComponent')/]"
    	version: "[ac.eGet('componentVersion')/]"
    	configuration:
      		[ac.eGet('configurationKey')/]: "[ac.eGet('configurationValue')/]"
[elseif (ac.eClass().name = 'SecretsAccessConfiguration')]
[if (ac.eGet('accessList')->size()>0)]
	secret: 
		scopes: 
[for (sac:SecretsAccessList | ac.eGet('accessList'))]
			- storeName: [sac.eGet('secretStore').eGet('name')/]
[if (sac.eGet('defaultAccess') = AccessAction::ALLOW)]
      		  defaultAccess: allow
[if (sac.eGet('deniedSecrets')->size()>0)]
			  deniedSecrets: ['['/][for (s:String | sac.eGet('deniedSecrets'))]"[s/]",[/for][']'/]
[/if]
[else]
			  defaultAccess: deny
[if (sac.eGet('allowedSecrets')->size()>0)]
			  allowedSecrets: ['['/][for (s:String | sac.eGet('allowedSecrets'))]"[s/]",[/for][']'/]
[/if]
[/if]
[/for]
[/if]
[elseif (ac.eClass().name = 'MetricsConfiguration')]
	metrics:
	  enabled: [ac.eGet('enabled')/]
	  latencyDistributionBuckets: ['['/][ac.eGet('latencyDistributionBuckets')/][']'/]
	  http:
	    increasedCardinality: [ac.eGet('http_increasedCardinality')/]
[if (ac.eGet('http_pathMatching')->size() > 0)]
	    pathMatching:
[for (s:String | ac.eGet('http_pathMatching'))]
			- [s/]
[/for]
[/if]	      
	    excludeVerbs: [ac.eGet('http_excludeVerbs')/]
	  recordErrorCodes: false

[elseif (ac.eClass().name = 'MetricsConfiguration')]
[/if]
[/for]
[/if]


[/file]
[/template]
